{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["type:tool"],
  "implicitDependencies": [
    "@layzee/node-test-extensions",
    "@layzee/stryker-node-test-runner",
    "@layzee/stryker-node-mutators",
    "@layzee/stryker-js-mutators",
    "@layzee/stryker-node-test-mutators",
    "@layzee/stryker-mutator-core"
  ],
  "targets": {
    "test": {
      "command": "node --test \"e2e/test/unit/*.test.ts\"",
      "options": { "cwd": "{workspaceRoot}" }
    },
    "oss": {
      "command": "node e2e/src/oss/main.ts",
      "options": { "cwd": "{workspaceRoot}" },
      "cache": false,
      "parallelism": false,
      "dependsOn": ["^build"]
    },
    "e2e": {
      "command": "node --test --test-concurrency=1 \"e2e/test/*.e2e.ts\"",
      "options": { "cwd": "{workspaceRoot}" },
      "cache": true,
      "parallelism": false,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "!{projectRoot}/src/oss/**/*",
        "!{projectRoot}/test/unit/oss-*.test.ts",
        "!{projectRoot}/stryker*.config.mjs",
        "!{projectRoot}/tsconfig.stryker.json",
        "^production",
        "nodeVersion",
        "{workspaceRoot}/package.json",
        {
          "externalDependencies": [
            "@stryker-mutator/core",
            "@stryker-mutator/typescript-checker",
            "typescript",
            "@types/node"
          ]
        }
      ]
    },
    "mutate": {},
    "mutate-src": {},
    "mutate-test-code": {}
  }
}
