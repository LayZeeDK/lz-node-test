{
  "name": "e2e",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["type:tool"],
  "implicitDependencies": [
    "@layzee/node-test-extensions",
    "@layzee/stryker-node-test-runner",
    "@layzee/stryker-node-test-mutators"
  ],
  "targets": {
    "test": {
      "command": "node --test \"e2e/test/unit/*.test.ts\"",
      "options": { "cwd": "{workspaceRoot}" }
    },
    "oss": {
      "command": "node e2e/src/oss/main.ts",
      "options": { "cwd": "{workspaceRoot}" },
      "cache": false,
      "parallelism": false,
      "dependsOn": ["^build"]
    },
    "e2e": {
      "command": "node --test --test-concurrency=1 \"e2e/test/*.e2e.ts\"",
      "options": { "cwd": "{workspaceRoot}" },
      "cache": true,
      "parallelism": false,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "!{projectRoot}/src/oss/**/*",
        "!{projectRoot}/test/unit/oss-*.test.ts",
        "^production",
        "nodeVersion",
        "{workspaceRoot}/package.json",
        {
          "externalDependencies": [
            "@stryker-mutator/core",
            "@stryker-mutator/typescript-checker",
            "typescript",
            "@types/node"
          ]
        }
      ]
    }
  }
}
