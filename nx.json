{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": [],
    "nodeVersion": [{ "runtime": "node -v" }]
  },
  "targetDefaults": {
    "test": {
      "cache": true,
      "inputs": ["default", "^production", "nodeVersion"]
    },
    "test-integration": {
      "cache": true,
      "inputs": ["default", "^production", "nodeVersion"]
    },
    "mutate": {
      "executor": "nx:run-commands",
      "cache": true,
      "parallelism": false,
      "dependsOn": ["build"],
      "inputs": [
        "default",
        "^production",
        "nodeVersion",
        "{workspaceRoot}/stryker.base.mjs",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/packages/lz-stryker-node-test-runner/src/**/*",
        "{workspaceRoot}/packages/lz-stryker-node-test-mutators/src/**/*",
        { "externalDependencies": ["@stryker-mutator/core", "@stryker-mutator/typescript-checker", "typescript"] }
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "node --conditions=@lz-node-test/source node_modules/@stryker-mutator/core/bin/stryker.js run {projectRoot}/stryker.config.mjs",
          "node --conditions=@lz-node-test/source node_modules/@stryker-mutator/core/bin/stryker.js run {projectRoot}/stryker.test-code.config.mjs"
        ]
      }
    }
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "exclude": ["e2e/fixtures/**"],
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    }
  ]
}
