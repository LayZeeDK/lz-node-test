{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": [],
    "nodeVersion": [{ "runtime": "node -v" }],
    "mutation": [
      "nodeVersion",
      "{workspaceRoot}/stryker.base.mjs",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/packages/lz-stryker-node-test-runner/src/**/*",
      "{workspaceRoot}/packages/lz-stryker-node-test-mutators/src/**/*",
      "{workspaceRoot}/tools/eslint-rules/runtime-errors.ts",
      "{workspaceRoot}/tools/eslint-rules/runtime-errors.cli.ts",
      "{workspaceRoot}/tools/eslint-rules/runtime-errors.json",
      { "externalDependencies": ["@stryker-mutator/core", "@stryker-mutator/typescript-checker", "typescript"] }
    ]
  },
  "targetDefaults": {
    "test": {
      "cache": true,
      "inputs": ["default", "^production", "nodeVersion"]
    },
    "test-integration": {
      "cache": true,
      "inputs": ["default", "^production", "nodeVersion"]
    },
    "mutate-src": {
      "executor": "nx:run-commands",
      "cache": true,
      "parallelism": false,
      "dependsOn": ["build"],
      "inputs": ["default", "^production", "mutation"],
      "outputs": [
        "{workspaceRoot}/reports/mutation/{projectName}.src.html",
        "{workspaceRoot}/reports/mutation/{projectName}.src.json"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "node --conditions=@lz-node-test/source node_modules/@stryker-mutator/core/bin/stryker.js run {projectRoot}/stryker.config.mjs",
          {
            "command": "node tools/eslint-rules/runtime-errors.cli.ts reports/mutation/{projectName}.src.json",
            "forwardAllArgs": false
          }
        ]
      }
    },
    "mutate-test-code": {
      "executor": "nx:run-commands",
      "cache": true,
      "parallelism": false,
      "dependsOn": ["build"],
      "inputs": ["default", "^production", "mutation"],
      "outputs": [
        "{workspaceRoot}/reports/mutation/{projectName}.test-code.html",
        "{workspaceRoot}/reports/mutation/{projectName}.test-code.json"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "node --conditions=@lz-node-test/source node_modules/@stryker-mutator/core/bin/stryker.js run {projectRoot}/stryker.test-code.config.mjs",
          {
            "command": "node tools/eslint-rules/runtime-errors.cli.ts reports/mutation/{projectName}.test-code.json",
            "forwardAllArgs": false
          }
        ]
      }
    },
    "mutate": {
      "executor": "nx:noop",
      "dependsOn": ["mutate-src", "mutate-test-code"]
    }
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "exclude": ["e2e/fixtures/**"],
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    }
  ]
}
