{
  "name": "@layzee/lz-node-test",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@lz-node-test/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --conditions=@lz-node-test/source --test \"test/unit/**/*.test.ts\"",
    "test-integration": "node --conditions=@lz-node-test/source --test \"test/integration/**/*.test.ts\""
  },
  "nx": {
    "name": "lz-node-test",
    "tags": [
      "type:lib"
    ]
  }
}
