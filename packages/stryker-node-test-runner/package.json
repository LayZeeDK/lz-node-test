{
  "name": "@layzee/stryker-node-test-runner",
  "version": "0.0.0",
  "private": true,
  "description": "A StrykerJS test runner for node:test that runs each test file in its own node process",
  "license": "MIT",
  "keywords": [
    "stryker",
    "stryker-plugin",
    "node:test",
    "@stryker-mutator/test-runner-plugin"
  ],
  "homepage": "https://github.com/LayZeeDK/lz-node-test/tree/main/packages/stryker-node-test-runner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LayZeeDK/lz-node-test.git",
    "directory": "packages/stryker-node-test-runner"
  },
  "bugs": {
    "url": "https://github.com/LayZeeDK/lz-node-test/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@lz-node-test/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --conditions=@lz-node-test/source --test \"test/unit/**/*.test.ts\"",
    "test-integration": "node --conditions=@lz-node-test/source --test \"test/integration/**/*.test.ts\"",
    "bench": "node --conditions=@lz-node-test/source test/runner.bench.ts"
  },
  "peerDependencies": {
    "@stryker-mutator/api": "^10.1.1",
    "@stryker-mutator/core": "^10.1.1"
  },
  "devDependencies": {
    "@layzee/node-test-extensions": "*"
  },
  "initStrykerConfig": {
    "testRunner": "lz-node-test",
    "appendPlugins": [
      "@layzee/stryker-node-test-runner"
    ]
  },
  "nx": {
    "tags": [
      "type:lib"
    ],
    "targets": {
      "mutate": {},
      "mutate-src": {},
      "mutate-test-code": {},
      "test-integration": {
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
