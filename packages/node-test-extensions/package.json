{
  "name": "@layzee/node-test-extensions",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@layzee/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --conditions=@layzee/source --test \"test/unit/**/*.test.ts\"",
    "test-integration": "node --conditions=@layzee/source --test \"test/integration/**/*.test.ts\""
  },
  "nx": {
    "tags": [
      "type:lib"
    ],
    "targets": {
      "mutate": {},
      "mutate-src": {},
      "mutate-test-code": {}
    }
  }
}
