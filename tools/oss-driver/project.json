{
  "name": "oss-driver",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["type:tool"],
  "implicitDependencies": ["lz-node-test", "lz-stryker-node-test-runner", "lz-stryker-node-test-mutators"],
  "targets": {
    "test": {
      "command": "node --test \"test/*.test.ts\"",
      "options": { "cwd": "{projectRoot}" }
    },
    "oss": {
      "command": "node tools/oss-driver/src/main.ts",
      "options": { "cwd": "{workspaceRoot}" },
      "cache": false,
      "parallelism": false,
      "dependsOn": ["^build"]
    }
  }
}
