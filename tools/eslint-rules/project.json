{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": ["type:tool"],
  "namedInputs": {
    "workspaceConfigs": [
      "{workspaceRoot}/packages/*/stryker*.config.mjs",
      "{workspaceRoot}/e2e/stryker*.config.mjs",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/packages/*/eslint.config.mjs",
      "{workspaceRoot}/.github/workflows/ci.yml",
      "{workspaceRoot}/packages/*/src/**/*.ts",
      "eslintPlugins"
    ]
  },
  "targets": {
    "test": {
      "command": "node --conditions=@layzee/source --test \"*.test.ts\"",
      "options": { "cwd": "{projectRoot}" },
      "inputs": ["default", "^production", "mutation", "workspaceConfigs"]
    },
    "mutate": {},
    "mutate-src": {
      "inputs": ["default", "^production", "mutation", "workspaceConfigs"]
    },
    "mutate-test-code": {
      "inputs": ["default", "^production", "mutation", "workspaceConfigs"]
    }
  }
}
